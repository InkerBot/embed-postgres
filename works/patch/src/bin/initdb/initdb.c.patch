+/* -----------------------------------------------------------------------
+ * Embed mode: tokenizer and subprocess helpers.
+ *
+ * initdb builds shell command strings (e.g. "\"path/to/postgres\" --boot -D ...").
+ * In embed mode, we parse these back into argv and fork+call embed_pg_main_hook
+ * instead of popen()/system().
+ * ----------------------------------------------------------------------- */
+
+/*
+ * Simple shell-command tokenizer.
+ *
+ * Handles double-quoted tokens (postgres path may contain spaces).
+ * Stops at shell redirection operators (>, <, digit>).
+ * Returns a malloc'd NULL-terminated argv array; caller frees each element
+ * and the array itself.
+ */
+static char **
+embed_tokenize_shell_cmd(const char *cmd, int *argc_out)
+{
+	int		cap = 16;
+	char  **argv = malloc(cap * sizeof(char *));
+	int		argc = 0;
+	const char *p = cmd;
+
+	if (!argv)
+	{
+		*argc_out = 0;
+		return NULL;
+	}
+
+	while (*p)
+	{
+		/* Skip whitespace */
+		while (*p == ' ' || *p == '\t') p++;
+		if (!*p) break;
+
+		/* Stop at redirections: >, <, or digit> (e.g. 2>) */
+		if (*p == '>' || *p == '<')
+			break;
+		if (*p >= '0' && *p <= '9' && *(p + 1) == '>')
+			break;
+
+		/* Read one token */
+		char buf[4096];
+		int  len = 0;
+
+		if (*p == '"')
+		{
+			/* Double-quoted token (the postgres binary path) */
+			p++; /* skip opening quote */
+			while (*p && *p != '"')
+			{
+				if (*p == '\\' && *(p + 1)) p++; /* handle backslash escape */
+				if (len < (int) sizeof(buf) - 1)
+					buf[len++] = *p;
+				p++;
+			}
+			if (*p == '"') p++; /* skip closing quote */
+		}
+		else
+		{
+			/* Unquoted token: read until whitespace or redirection */
+			while (*p && *p != ' ' && *p != '\t' &&
+				   *p != '>' && *p != '<')
+			{
+				if (len < (int) sizeof(buf) - 1)
+					buf[len++] = *p;
+				p++;
+			}
+		}
+		buf[len] = '\0';
+
+		/* Grow argv if needed */
+		if (argc >= cap - 1)
+		{
+			cap *= 2;
+			char **tmp = realloc(argv, cap * sizeof(char *));
+			if (!tmp)
+			{
+				for (int i = 0; i < argc; i++) free(argv[i]);
+				free(argv);
+				*argc_out = 0;
+				return NULL;
+			}
+			argv = tmp;
+		}
 
+		argv[argc++] = strdup(buf);
+	}
+
+	argv[argc] = NULL;
+	*argc_out  = argc;
+	return argv;
+}
+
+static void
+embed_free_argv(char **argv, int argc)
+{
+	for (int i = 0; i < argc; i++)
+		free(argv[i]);
+	free(argv);
+}
+
+/* Track FILE* -> child-pid mapping for embed popen children */
+#define MAX_EMBED_POPEN 8
+static struct
+{
+	FILE  *f;
+	pid_t  pid;
+} embed_popen_children[MAX_EMBED_POPEN];
+static int embed_popen_count = 0;
+
+/*
+ * embed_popen_impl --- replacement for popen() in embed mode.
+ *
+ * Creates a pipe, forks a child that calls embed_pg_main_hook() with stdin
+ * redirected to the pipe's read end, and returns the pipe's write end
+ * wrapped in a FILE* for the caller to write SQL/BKI.
+ */
+static FILE *
+embed_popen_impl(const char *cmd, const char *mode)
+{
+	int pipefd[2];
+
+	if (pipe(pipefd) < 0)
+		return NULL;
+
+	int		argc;
+	char  **argv = embed_tokenize_shell_cmd(cmd, &argc);
+	if (!argv || argc < 1)
+	{
+		close(pipefd[0]);
+		close(pipefd[1]);
+		if (argv) free(argv);
+		return NULL;
+	}
+
+	pid_t child = fork();
+	if (child < 0)
+	{
+		close(pipefd[0]);
+		close(pipefd[1]);
+		embed_free_argv(argv, argc);
+		return NULL;
+	}
+
+	if (child == 0)
+	{
+		/* Child: redirect stdin to the pipe's read end */
+		dup2(pipefd[0], STDIN_FILENO);
+		close(pipefd[0]);
+		close(pipefd[1]);
+
+		embed_subprocess = true;
+		optind = 1;
+
+		embed_pg_main_hook(argc, argv);
+		_exit(0);
+	}
+
+	/* Parent: close the read end, return write end as FILE* */
+	close(pipefd[0]);
+	embed_free_argv(argv, argc);
+
+	FILE *f = fdopen(pipefd[1], "w");
+	if (!f)
+	{
+		close(pipefd[1]);
+		waitpid(child, NULL, 0);
+		return NULL;
+	}
+
+	if (embed_popen_count < MAX_EMBED_POPEN)
+	{
+		embed_popen_children[embed_popen_count].f   = f;
+		embed_popen_children[embed_popen_count].pid = child;
+		embed_popen_count++;
+	}
+
+	return f;
+}
+
+/*
+ * embed_pclose_impl --- replacement for pclose_check() in embed mode.
+ *
+ * Closes the write-end pipe and waits for the pg_main child to finish.
+ * Returns 0 on success, 1 on failure.
+ */
+static int
+embed_pclose_impl(FILE *stream)
+{
+	fclose(stream);
+
+	for (int i = 0; i < embed_popen_count; i++)
+	{
+		if (embed_popen_children[i].f == stream)
+		{
+			int status;
+			waitpid(embed_popen_children[i].pid, &status, 0);
+
+			embed_popen_children[i] = embed_popen_children[--embed_popen_count];
+
+			if (WIFEXITED(status) && WEXITSTATUS(status) == 0)
+				return 0;
+
+			pg_log_error("embed_initdb: backend subprocess exited with status %d",
+						 WIFEXITED(status) ? WEXITSTATUS(status) : -1);
+			return 1;
+		}
+	}
+
+	return 1;
+}
+
+/*
+ * embed_system_impl --- replacement for system() in embed mode.
+ *
+ * Forks a child that calls embed_pg_main_hook() with stdin/stdout/stderr
+ * redirected to /dev/null (mirroring the shell command's redirection).
+ * Returns the process exit status (0 = success).
+ */
+static int
+embed_system_impl(const char *cmd)
+{
+	int		argc;
+	char  **argv = embed_tokenize_shell_cmd(cmd, &argc);
+	if (!argv || argc < 1)
+	{
+		if (argv) free(argv);
+		return -1;
+	}
+
+	pid_t child = fork();
+	if (child < 0)
+	{
+		embed_free_argv(argv, argc);
+		return -1;
+	}
+
+	if (child == 0)
+	{
+		int devnull = open("/dev/null", O_RDWR);
+		if (devnull >= 0)
+		{
+			dup2(devnull, STDIN_FILENO);
+			dup2(devnull, STDOUT_FILENO);
+			dup2(devnull, STDERR_FILENO);
+			close(devnull);
+		}
+
+		embed_subprocess = true;
+		optind = 1;
+
+		embed_pg_main_hook(argc, argv);
+		_exit(0);
+	}
+
+	embed_free_argv(argv, argc);
+
+	int status;
+	waitpid(child, &status, 0);
+	return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+}
