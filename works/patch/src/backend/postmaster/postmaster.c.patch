+/*
+ * Enter embed mode when the host handed us a control socket.
+ *
+ * The descriptor is inherited across the exec that started us and named in the
+ * environment, so the host needs neither a symbol lookup nor a signal to set
+ * this up — it can bring the postmaster into being with a plain posix_spawn().
+ */
+static void
+embed_init_control_fd(void)
+{
+	const char *value = getenv("EMBED_CONTROL_FD");
+	char	   *endptr;
+	long		fd;
+
+	if (value == NULL || *value == '\0')
+		return;
+
+	errno = 0;
+	fd = strtol(value, &endptr, 10);
+	if (errno != 0 || *endptr != '\0' || fd < 0 || fd > INT_MAX)
+		ereport(FATAL,
+				(errmsg("invalid value for EMBED_CONTROL_FD: \"%s\"", value)));
+
+	embed_control_fd = (int) fd;
+	embed_mode = true;
+}
+
+/*
+ * Receive one command byte from the embed control socket, plus the descriptor
+ * it carries, if any.  Returns 0 on success, -1 on error or peer disconnect.
+ */
+static int
+embed_recv_fd(int socket, char *cmd, int *fd)
+{
+	char cmsgbuf[CMSG_SPACE(sizeof(int))];
+	struct cmsghdr *cmsg;
+	struct iovec iov;
+	struct msghdr msg;
+	ssize_t n;
+
+	*cmd = 0;
+	*fd = -1;
+
+	iov.iov_base = cmd;
+	iov.iov_len = 1;
+
+	memset(cmsgbuf, 0, sizeof(cmsgbuf));
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	msg.msg_control = cmsgbuf;
+	msg.msg_controllen = sizeof(cmsgbuf);
+
+	do
+	{
+		n = recvmsg(socket, &msg, 0);
+	} while (n < 0 && errno == EINTR);
+
+	if (n <= 0)
+		return -1;
+
+	for (cmsg = CMSG_FIRSTHDR(&msg); cmsg != NULL;
+		 cmsg = CMSG_NXTHDR(&msg, cmsg))
+	{
+		if (cmsg->cmsg_level == SOL_SOCKET &&
+			cmsg->cmsg_type == SCM_RIGHTS &&
+			cmsg->cmsg_len == CMSG_LEN(sizeof(int)))
+		{
+			memcpy(fd, CMSG_DATA(cmsg), sizeof(int));
+			break;
+		}
+	}
+
+	/* A truncated control message may have dropped descriptors on the floor */
+	if (msg.msg_flags & MSG_CTRUNC)
+	{
+		if (*fd >= 0)
+			close(*fd);
+		*fd = -1;
+		return -1;
+	}
+
+	return 0;
+}
+
+/*
+ * Tell the embed host that we are accepting connections.  Sent from both
+ * PM_RUN and the PM_STARTUP -> PM_HOT_STANDBY transition, so the host may see
+ * it more than once and must treat it as an asynchronous notice.  Send errors
+ * are ignored: a host that is gone also closes the control channel, which
+ * ServerLoop already turns into a shutdown.
+ */
+static void
+embed_notify_ready(void)
+{
+	char		ready_byte = EMBED_MSG_READY;
+
+	if (embed_mode && embed_control_fd >= 0)
+		send(embed_control_fd, &ready_byte, 1, 0);
+}
+
+/*
+ * Report the exit status to the embed host on the way out.
+ *
+ * This is what frees the host from waiting on us: it learns the status from
+ * the control channel instead of from waitpid(), so it never has to compete
+ * with whatever SIGCHLD handling its own runtime installs.  A host that died
+ * first leaves no reader, hence the ignored send() error.
+ */
+static void
+embed_notify_exit(int status)
+{
+	char		msg[2];
+
+	if (!embed_mode || embed_control_fd < 0)
+		return;
+
+	msg[0] = EMBED_MSG_EXITING;
+	msg[1] = (char) (unsigned char) status;
+	send(embed_control_fd, msg, sizeof(msg), 0);
+}
+
+/*
+ * Handle a readable embed control fd.  Every EMBED_CMD_CONNECT is answered
+ * with exactly one reply byte, so the host never hands out a PGconn for a
+ * backend that was not started.
+ */
+static void
+embed_handle_control_event(void)
+{
+	char cmd = 0;
+	int fd = -1;
+	char reply;
+	ClientSocket cs;
+
+	if (embed_recv_fd(embed_control_fd, &cmd, &fd) < 0 ||
+		cmd == EMBED_CMD_SHUTDOWN)
+	{
+		/* Shutdown request, or the control channel went away */
+		if (fd >= 0)
+			close(fd);
+		pending_pm_fast_shutdown_request = true;
+		pending_pm_shutdown_request = true;
+		SetLatch(MyLatch);
+		return;
+	}
+
+	if (cmd != EMBED_CMD_CONNECT)
+	{
+		if (fd >= 0)
+			close(fd);
+		return;
+	}
+
+	if (fd < 0)
+	{
+		reply = EMBED_MSG_ERROR;
+		send(embed_control_fd, &reply, 1, 0);
+		return;
+	}
+
+	/*
+	 * Reporting the peer as AF_UNIX is what makes embed connections match the
+	 * "local" lines of pg_hba.conf rather than any host rule.
+	 */
+	cs.sock = fd;
+	memset(&cs.raddr, 0, sizeof(cs.raddr));
+	cs.raddr.addr.ss_family = AF_UNIX;
+	cs.raddr.salen = sizeof(struct sockaddr_un);
+
+	reply = (BackendStartup(&cs) == STATUS_OK)
+		? EMBED_MSG_ACK : EMBED_MSG_ERROR;
+
+	/* BackendStartup has forked; the child holds its own copy */
+	close(fd);
+
+	send(embed_control_fd, &reply, 1, 0);
+}
