+/*
+ * Receive a file descriptor via SCM_RIGHTS on the embed control socket.
+ * Sets *cmd to the command byte ('C' for connect, 'S' for shutdown).
+ * Returns the received fd, or -1 on error/disconnect.
+ */
+static int
+embed_recv_fd(int socket, char *cmd)
+{
+	char cmsgbuf[CMSG_SPACE(sizeof(int))];
+	struct cmsghdr *cmsg;
+	struct iovec iov;
+	struct msghdr msg;
+	int fd;
+
+	iov.iov_base = cmd;
+	iov.iov_len = 1;
+
+	memset(cmsgbuf, 0, sizeof(cmsgbuf));
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	msg.msg_control = cmsgbuf;
+	msg.msg_controllen = sizeof(cmsgbuf);
+
+	if (recvmsg(socket, &msg, 0) <= 0)
+		return -1;
+
+	cmsg = CMSG_FIRSTHDR(&msg);
+	if (!cmsg)
+		return -1;
+
+	memcpy(&fd, CMSG_DATA(cmsg), sizeof(int));
+	return fd;
+}
+
+/*
+ * Handle an event on the embed control fd.
+ * Called from ServerLoop when the control fd is readable.
+ */
+static void
+embed_handle_control_event(void)
+{
+	char cmd = 0;
+	int fd = embed_recv_fd(embed_control_fd, &cmd);
+
+	if (fd < 0 || cmd == 'S')
+	{
+		/* Shutdown request or control fd closed */
+		pending_pm_fast_shutdown_request = true;
+		pending_pm_shutdown_request = true;
+		SetLatch(MyLatch);
+		return;
+	}
+
+	if (cmd == 'C')
+	{
+		ClientSocket cs;
+		char ack = 'A';
+
+		/* Connection request: create ClientSocket and start a backend */
+		cs.sock = fd;
+		memset(&cs.raddr, 0, sizeof(cs.raddr));
+		cs.raddr.addr.ss_family = AF_UNIX;
+		cs.raddr.salen = sizeof(struct sockaddr_un);
+		BackendStartup(&cs);
+
+		/* Close the fd — BackendStartup has forked and the child has its copy */
+		close(fd);
+
+		/* Send ACK to parent */
+		send(embed_control_fd, &ack, 1, 0);
+	}
+}
