--- a/src/interfaces/libpq/fe-connect.c
+++ b/src/interfaces/libpq/fe-connect.c
@@ -8421,3 +8421,144 @@
 	Assert(pg_g_threadlock);
 	return pg_g_threadlock;
 }
+
+/*
+ * PQconnectSocket - create a PGconn from an already-connected socket fd.
+ *
+ * This is used by embed mode: the caller provides an fd from socketpair()
+ * that is already connected to a PostgreSQL backend. We wrap it in a PGconn,
+ * send the startup packet, and drive the handshake to completion.
+ *
+ * The conninfo string provides dbname, user, client_encoding, etc.
+ * Host/port are irrelevant since the socket is already connected.
+ */
+PGconn *
+PQconnectSocket(int fd, const char *conninfo)
+{
+	PGconn	   *conn;
+	PQconninfoOption *connOptions;
+	PQExpBufferData errorBuf;
+	PostgresPollingStatusType poll_status;
+
+	initPQExpBuffer(&errorBuf);
+
+	/*
+	 * Allocate an empty PGconn struct.
+	 */
+	conn = pqMakeEmptyPGconn();
+	if (conn == NULL)
+	{
+		termPQExpBuffer(&errorBuf);
+		return NULL;
+	}
+
+	/*
+	 * Parse the conninfo string and fill in connection parameters.
+	 */
+	connOptions = conninfo_parse(conninfo, &errorBuf, true);
+	if (connOptions == NULL)
+	{
+		appendPQExpBufferStr(&conn->errorMessage, errorBuf.data);
+		conn->status = CONNECTION_BAD;
+		termPQExpBuffer(&errorBuf);
+		return conn;
+	}
+	termPQExpBuffer(&errorBuf);
+
+	if (!fillPGconn(conn, connOptions))
+	{
+		PQconninfoFree(connOptions);
+		return conn;
+	}
+	PQconninfoFree(connOptions);
+
+	/*
+	 * Compute derived connection options (this sets up things like
+	 * client_encoding, etc.)
+	 */
+	if (!pqConnectOptions2(conn))
+		return conn;
+
+	/*
+	 * Install the pre-connected socket fd directly.
+	 */
+	conn->sock = fd;
+	conn->options_valid = true;
+
+	/* Clear I/O buffers */
+	conn->inStart = conn->inCursor = conn->inEnd = 0;
+	conn->outCount = 0;
+
+	/*
+	 * Set protocol version. This is normally done during connection
+	 * negotiation, but we skip that for socketpair connections.
+	 */
+	conn->pversion = PG_PROTOCOL_LATEST;
+
+	/*
+	 * Set the connection state to CONNECTION_MADE, which tells
+	 * PQconnectPoll to send the startup packet. We skip all encryption
+	 * negotiation since this is a local socketpair.
+	 */
+	conn->status = CONNECTION_MADE;
+	conn->current_enc_method = ENC_PLAINTEXT;
+
+	/*
+	 * Set up a dummy connhost entry so libpq doesn't crash when it tries
+	 * to access host info during the handshake.
+	 */
+	if (conn->connhost == NULL)
+	{
+		conn->nconnhost = 1;
+		conn->whichhost = 0;
+		conn->connhost = calloc(1, sizeof(pg_conn_host));
+		if (conn->connhost == NULL)
+		{
+			libpq_append_conn_error(conn, "out of memory");
+			conn->status = CONNECTION_BAD;
+			return conn;
+		}
+		conn->connhost[0].type = CHT_UNIX_SOCKET;
+		conn->connhost[0].host = strdup("");
+		conn->connhost[0].hostaddr = strdup("");
+		conn->connhost[0].port = strdup("5432");
+	}
+
+	/*
+	 * Drive PQconnectPoll to send startup packet and complete handshake.
+	 * This handles: StartupMessage -> AuthRequest -> ParameterStatus ->
+	 * BackendKeyData -> ReadyForQuery.
+	 */
+	for (;;)
+	{
+		poll_status = PQconnectPoll(conn);
+		if (poll_status == PGRES_POLLING_OK)
+			break;
+		if (poll_status == PGRES_POLLING_FAILED)
+			break;
+
+		/* Wait for the socket to be ready */
+		if (poll_status == PGRES_POLLING_READING)
+		{
+			if (PQsocketPoll(conn->sock, 1, 0, -1) < 0)
+			{
+				libpq_append_conn_error(conn, "PQsocketPoll() failed: %s",
+										strerror(errno));
+				conn->status = CONNECTION_BAD;
+				break;
+			}
+		}
+		else if (poll_status == PGRES_POLLING_WRITING)
+		{
+			if (PQsocketPoll(conn->sock, 0, 1, -1) < 0)
+			{
+				libpq_append_conn_error(conn, "PQsocketPoll() failed: %s",
+										strerror(errno));
+				conn->status = CONNECTION_BAD;
+				break;
+			}
+		}
+	}
+
+	return conn;
+}
