diff --git a/src/interfaces/libpq/fe-connect.c b/src/interfaces/libpq/fe-connect.c
index db9b4c8..b2e9c35 100644
--- a/src/interfaces/libpq/fe-connect.c
+++ b/src/interfaces/libpq/fe-connect.c
@@ -8421,3 +8421,153 @@ PQgetThreadLock(void)
 	Assert(pg_g_threadlock);
 	return pg_g_threadlock;
 }
+
+/*
+ * PQconnectSocket - create a PGconn from an already-connected socket fd.
+ *
+ * Used by embed mode: fd is one end of a socketpair whose peer is already a
+ * backend, so connection establishment is skipped and only the startup
+ * handshake is driven here.  Host and port in conninfo are irrelevant.
+ *
+ * Ownership of fd transfers to the returned PGconn, so PQfinish() closes it —
+ * including when the returned connection is CONNECTION_BAD.  The only case the
+ * caller still has to handle is a NULL return (out of memory), where the fd has
+ * already been closed here.
+ */
+PGconn *
+PQconnectSocket(int fd, const char *conninfo)
+{
+	PGconn	   *conn;
+	PQconninfoOption *connOptions;
+	PQExpBufferData errorBuf;
+	PostgresPollingStatusType poll_status;
+	char		sebuf[PG_STRERROR_R_BUFLEN];
+
+	initPQExpBuffer(&errorBuf);
+
+	conn = pqMakeEmptyPGconn();
+	if (conn == NULL)
+	{
+		termPQExpBuffer(&errorBuf);
+		close(fd);
+		return NULL;
+	}
+
+	/*
+	 * Adopt the descriptor before anything that can fail, so that every error
+	 * path below hands back a PGconn whose PQfinish() closes it.
+	 */
+	conn->sock = fd;
+
+	connOptions = conninfo_parse(conninfo, &errorBuf, true);
+	if (connOptions == NULL)
+	{
+		appendPQExpBufferStr(&conn->errorMessage, errorBuf.data);
+		conn->status = CONNECTION_BAD;
+		termPQExpBuffer(&errorBuf);
+		return conn;
+	}
+	termPQExpBuffer(&errorBuf);
+
+	if (!fillPGconn(conn, connOptions))
+	{
+		PQconninfoFree(connOptions);
+		return conn;
+	}
+	PQconninfoFree(connOptions);
+
+	if (!pqConnectOptions2(conn))
+		return conn;
+
+	conn->options_valid = true;
+
+	/*
+	 * Repeat the socket setup that the normal path performs after connect().
+	 * Without it the caller would get a blocking descriptor with no SIGPIPE
+	 * protection, and PQsetnonblocking()/PQconsumeInput() would not behave as
+	 * documented.  TCP-only setup (nodelay, keepalives) is skipped on purpose;
+	 * the descriptor is always a local socketpair here.
+	 */
+	if (!pg_set_noblock(conn->sock))
+	{
+		libpq_append_conn_error(conn, "could not set socket to nonblocking mode: %s",
+								SOCK_STRERROR(SOCK_ERRNO, sebuf, sizeof(sebuf)));
+		conn->status = CONNECTION_BAD;
+		return conn;
+	}
+
+#ifdef F_SETFD
+	if (fcntl(conn->sock, F_SETFD, FD_CLOEXEC) == -1)
+	{
+		libpq_append_conn_error(conn, "could not set socket to close-on-exec mode: %s",
+								SOCK_STRERROR(SOCK_ERRNO, sebuf, sizeof(sebuf)));
+		conn->status = CONNECTION_BAD;
+		return conn;
+	}
+#endif
+
+	/* Block SIGPIPE on sends; see the long comment in PQconnectPoll(). */
+	conn->sigpipe_so = false;
+#ifdef MSG_NOSIGNAL
+	conn->sigpipe_flag = true;
+#else
+	conn->sigpipe_flag = false;
+#endif
+#ifdef SO_NOSIGPIPE
+	{
+		int			optval = 1;
+
+		if (setsockopt(conn->sock, SOL_SOCKET, SO_NOSIGPIPE,
+					   (char *) &optval, sizeof(optval)) == 0)
+		{
+			conn->sigpipe_so = true;
+			conn->sigpipe_flag = false;
+		}
+	}
+#endif
+
+	conn->inStart = conn->inCursor = conn->inEnd = 0;
+	conn->outCount = 0;
+
+	/* No negotiation happens on a socketpair, so pin the version ourselves */
+	conn->pversion = PG_PROTOCOL_LATEST;
+
+	/* CONNECTION_MADE makes PQconnectPoll send the startup packet next */
+	conn->status = CONNECTION_MADE;
+	conn->current_enc_method = ENC_PLAINTEXT;
+
+	/* Starting at CONNECTION_MADE skips the state that normally picks a host */
+	conn->whichhost = 0;
+
+	for (;;)
+	{
+		poll_status = PQconnectPoll(conn);
+		if (poll_status == PGRES_POLLING_OK)
+			break;
+		if (poll_status == PGRES_POLLING_FAILED)
+			break;
+
+		if (poll_status == PGRES_POLLING_READING)
+		{
+			if (PQsocketPoll(conn->sock, 1, 0, -1) < 0)
+			{
+				libpq_append_conn_error(conn, "PQsocketPoll() failed: %s",
+										strerror(errno));
+				conn->status = CONNECTION_BAD;
+				break;
+			}
+		}
+		else if (poll_status == PGRES_POLLING_WRITING)
+		{
+			if (PQsocketPoll(conn->sock, 0, 1, -1) < 0)
+			{
+				libpq_append_conn_error(conn, "PQsocketPoll() failed: %s",
+										strerror(errno));
+				conn->status = CONNECTION_BAD;
+				break;
+			}
+		}
+	}
+
+	return conn;
+}
