#!/bin/sh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/common.sh"

if [ ! -d "$POSTGRES/.git" ]; then
    echo "Cloning postgres..."
    if [ -n "$UPSTREAM_BRANCH" ]; then
        git clone -b "$UPSTREAM_BRANCH" "$REPO_URL" "$POSTGRES"
    else
        git clone "$REPO_URL" "$POSTGRES"
    fi
fi

if [ -f "$REV_FILE" ]; then
    REV="$(tr -d '[:space:]' < "$REV_FILE")"
    echo "Checking out stored rev: $REV"
    checkout_upstream_rev "$REV"
else
    echo "Warning: works/rev not found, using current HEAD." >&2
fi

echo "Initializing works/core/..."
rm -rf "$CORE"
mkdir -p "$CORE"
git init --quiet "$CORE"

echo "Syncing postgres files to works/core/..."
rsync -a --exclude='.git/' "$POSTGRES/" "$CORE/"
VERSION="$(git -C "$POSTGRES" describe --tags --always 2>/dev/null || git -C "$POSTGRES" rev-parse --short HEAD)"
core_git add -A
core_git commit --quiet -m "upstream: $VERSION"

echo "Applying patches..."
applied=0
failed=0
failed_list=""

if [ -d "$PATCH_DIR" ]; then
    patch_list="$(mktemp)"
    trap 'rm -f "$patch_list"' EXIT
    find "$PATCH_DIR" -name "*.patch" | sort > "$patch_list"

    while IFS= read -r patch_file; do
        rel="${patch_file#$PATCH_DIR/}"
        rel="${rel%.patch}"

        mkdir -p "$(dirname "$CORE/$rel")"

        # --3way writes conflict markers instead of rejecting a patch that no
        # longer applies.  It needs the "index" lines bin/generate emits and the
        # upstream blobs, which the commit above put in works/core's objects.
        if core_git apply --3way --whitespace=nowarn "$patch_file"; then
            applied=$((applied + 1))
        else
            echo "  FAILED:  $rel" >&2
            failed=$((failed + 1))
            failed_list="${failed_list}    ${rel}
"
        fi
    done < "$patch_list"
fi

core_git add -A
core_git commit --quiet -m "patches applied" --allow-empty

total=$((applied + failed))
echo ""
echo "Result: $applied/$total patches applied."
if [ "$failed" -gt 0 ]; then
    echo ""
    echo "Failed patches (merge conflicts written to files):"
    printf "%s" "$failed_list"
    echo ""
    echo "Resolve conflicts in works/core/, then run 'bin/generate' to update patches."
    exit 1
fi

echo "Done."
