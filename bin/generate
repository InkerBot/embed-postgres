#!/bin/sh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/common.sh"

if [ ! -d "$POSTGRES/.git" ]; then
    echo "Error: works/postgres not found. Run update first." >&2
    exit 1
fi

if [ ! -d "$CORE" ]; then
    echo "Error: works/core not found. Run apply first." >&2
    exit 1
fi

if [ -f "$REV_FILE" ]; then
    stored_rev="$(tr -d '[:space:]' < "$REV_FILE")"
    current_rev="$(git -C "$POSTGRES" rev-parse HEAD)"
    if [ "$stored_rev" != "$current_rev" ]; then
        echo "Warning: works/postgres is at $current_rev" >&2
        echo "         but works/rev records   $stored_rev" >&2
        echo "         Patches would capture unrelated upstream changes." >&2
        echo "         Run 'bin/apply' to rebuild works/core at the stored rev." >&2
    fi
fi

is_ignored() {
    [ -f "$IGNORE_FILE" ] || return 1
    _rel="$1"
    _name="${_rel##*/}"
    while IFS= read -r _pattern || [ -n "$_pattern" ]; do
        case "$_pattern" in
            ''|\#*) continue ;;
        esac
        case "$_pattern" in
            */*)
                case "$_rel" in $_pattern) return 0 ;; esac
                ;;
            *)
                case "$_name" in $_pattern) return 0 ;; esac
                case "$_rel" in $_pattern/*) return 0 ;; esac
                ;;
        esac
    done < "$IGNORE_FILE"
    return 1
}

emit_patch() {
    _src="$1"
    _dst="$2"
    _rel="$3"
    _out="$4"

    mkdir -p "$(dirname "$_out")"
    git diff --no-index --no-color --binary "$_src" "$_dst" | awk -v rel="$_rel" '
        !hunk {
            if (/^diff --git /) { print "diff --git a/" rel " b/" rel; next }
            if (/^--- /) { print ($0 == "--- /dev/null") ? $0 : "--- a/" rel; next }
            if (/^\+\+\+ /) { print ($0 == "+++ /dev/null") ? $0 : "+++ b/" rel; next }
            if (/^@@/) { hunk = 1 }
        }
        { print }
    ' > "$_out"
}

echo "Clearing existing patches..."
rm -rf "$PATCH_DIR"
mkdir -p "$PATCH_DIR"

echo "Generating patches for modified/new files..."
find "$CORE" -not -path "$CORE/.git/*" -type f | sort | while read -r dst_file; do
    rel="${dst_file#$CORE/}"
    if is_ignored "$rel"; then continue; fi
    src_file="$POSTGRES/$rel"
    patch_file="$PATCH_DIR/$rel.patch"

    if [ -f "$src_file" ]; then
        if ! cmp -s "$src_file" "$dst_file"; then
            emit_patch "$src_file" "$dst_file" "$rel" "$patch_file"
            echo "  Modified: $rel"
        fi
    else
        emit_patch /dev/null "$dst_file" "$rel" "$patch_file"
        echo "  New: $rel"
    fi
done

echo "Generating patches for deleted files..."
find "$POSTGRES" -not -path "$POSTGRES/.git/*" -type f | sort | while read -r src_file; do
    rel="${src_file#$POSTGRES/}"
    if is_ignored "$rel"; then continue; fi
    dst_file="$CORE/$rel"
    patch_file="$PATCH_DIR/$rel.patch"

    if [ ! -f "$dst_file" ]; then
        emit_patch "$src_file" /dev/null "$rel" "$patch_file"
        echo "  Deleted: $rel"
    fi
done

echo "Done."
