#!/bin/sh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/common.sh"

if [ -d "$POSTGRES/.git" ]; then
    echo "Updating postgres..."
    git -C "$POSTGRES" fetch --all
    if [ -n "$UPSTREAM_BRANCH" ]; then
        git -C "$POSTGRES" checkout "$UPSTREAM_BRANCH"
    fi
    git -C "$POSTGRES" pull
else
    echo "Cloning postgres..."
    if [ -n "$UPSTREAM_BRANCH" ]; then
        git clone -b "$UPSTREAM_BRANCH" "$REPO_URL" "$POSTGRES"
    else
        git clone "$REPO_URL" "$POSTGRES"
    fi
fi

REV="$(git -C "$POSTGRES" rev-parse HEAD)"
echo "$REV" > "$REV_FILE"

echo "Done. Version: $(git -C "$POSTGRES" describe --tags --always 2>/dev/null || echo "$REV")"
echo "Stored rev: $REV"
